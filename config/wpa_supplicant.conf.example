# Example only — do not commit real PSKs. Use wpa_passphrase or dietpi-config.
country=US
ctrl_interface=DIR=/run/wpa_supplicant GROUP=netdev
update_config=1

network={
	ssid="HomeSSID"
	scan_ssid=1
	key_mgmt=WPA-PSK
	priority=5
	psk=REPLACE_WITH_wpa_passphrase_OUTPUT
}

# Phone hotspot: prefer car-wifi-add-phone-hotspot (adds priority=10 block)
