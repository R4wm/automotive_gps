#!/usr/bin/env python3
"""Large GPS speed on Enviro/Enviro+ LCD (full backlight)."""

from __future__ import annotations

import argparse
import signal
import sys
import time
from pathlib import Path

import ST7735 as st7735
import serial
from PIL import Image, ImageDraw, ImageFont

KNOTS_TO_MPH = 1.15078
DEFAULT_PORT = "/dev/ttyUSB0"
DEFAULT_BAUD = 4800
DEFAULT_IDLE_IMAGE = Path("/usr/local/share/automotive_gps/fat_shy-guy.gif")
DEFAULT_IDLE_MAX_MPH = 3.0
SPI_SPEED_HZ = 10_000_000  # Pimoroni Enviro examples; faster full-frame updates
DEFAULT_IDLE_GIF_SPEED = 2.5  # multiply GIF frame rate (1 = file timing)
LOOP_SLEEP_IDLE = 0.008
LOOP_SLEEP_NORMAL = 0.025

# Display (160x80 landscape after rotation=270)
MARGIN = 6
BG = (0, 0, 0)
FG = (255, 255, 255)
NO_FIX_TEXT = "--"


def parse_rmc_speed_mph(line: str) -> float | None:
    line = line.strip()
    if len(line) < 10 or line[0] != "$":
        return None
    if not line.split(",", 1)[0].endswith("RMC"):
        return None
    parts = line.split(",")
    if len(parts) < 8 or parts[2] != "A":
        return None
    try:
        knots = float(parts[7])
    except ValueError:
        return None
    return max(0.0, knots * KNOTS_TO_MPH)


def load_font(size: int) -> ImageFont.FreeTypeFont | ImageFont.ImageFont:
    try:
        from fonts.ttf import RobotoMedium as font_path

        return ImageFont.truetype(font_path, size)
    except (ImportError, OSError):
        return ImageFont.load_default()


def fit_font(
    draw: ImageDraw.ImageDraw, text: str, max_w: int, max_h: int
) -> tuple[ImageFont.FreeTypeFont | ImageFont.ImageFont, int, int]:
    for size in range(76, 18, -2):
        font = load_font(size)
        x1, y1, x2, y2 = draw.textbbox((0, 0), text, font=font)
        w, h = x2 - x1, y2 - y1
        if w <= max_w and h <= max_h:
            return font, w, h
    font = load_font(18)
    x1, y1, x2, y2 = draw.textbbox((0, 0), text, font=font)
    return font, x2 - x1, y2 - y1


def draw_text_centered(
    draw: ImageDraw.ImageDraw,
    text: str,
    font: ImageFont.FreeTypeFont | ImageFont.ImageFont,
    width: int,
    height: int,
    fill: tuple[int, int, int],
) -> None:
    """Center text in the panel (PIL uses baseline anchoring at x, y)."""
    x1, y1, x2, y2 = draw.textbbox((0, 0), text, font=font)
    x = (width - (x2 - x1)) / 2 - x1
    y = (height - (y2 - y1)) / 2 - y1
    draw.text((x, y), text, font=font, fill=fill)


def format_speed(mph: float | None) -> str:
    if mph is None:
        return NO_FIX_TEXT
    return str(int(round(mph)))


def compose_idle_frame(source: Image.Image, width: int, height: int) -> Image.Image:
    max_w = width - 2 * MARGIN
    max_h = height - 2 * MARGIN
    frame = source.copy()
    if frame.mode in ("RGBA", "LA") or (
        frame.mode == "P" and "transparency" in frame.info
    ):
        frame = frame.convert("RGBA")
        flat = Image.new("RGB", frame.size, BG)
        flat.paste(frame, mask=frame.split()[3])
        frame = flat
    else:
        frame = frame.convert("RGB")
    frame.thumbnail((max_w, max_h), Image.Resampling.LANCZOS)
    canvas = Image.new("RGB", (width, height), BG)
    x = (width - frame.width) // 2
    y = (height - frame.height) // 2
    canvas.paste(frame, (x, y))
    return canvas


def load_idle_frames(
    path: Path, width: int, height: int, gif_speed: float
) -> tuple[list[Image.Image], list[float]]:
    if not path.is_file():
        return [], []
    try:
        source = Image.open(path)
    except OSError:
        return [], []

    frames: list[Image.Image] = []
    durations: list[float] = []
    index = 0
    while True:
        try:
            source.seek(index)
        except EOFError:
            break
        frames.append(compose_idle_frame(source, width, height))
        ms = source.info.get("duration")
        sec = (ms or 100) / 1000.0
        if gif_speed > 0:
            sec /= gif_speed
        durations.append(max(sec, 0.02))
        index += 1

    if not frames:
        return [], []
    if len(durations) < len(frames):
        durations.extend([0.1] * (len(frames) - len(durations)))
    return frames, durations


def display_key(mph: float | None, idle_max_mph: float, idle_enabled: bool) -> str:
    if mph is None:
        return f"text:{NO_FIX_TEXT}"
    shown = int(round(mph))
    if idle_enabled and shown <= int(round(idle_max_mph)):
        return "idle"
    return f"text:{shown}"


def main() -> None:
    parser = argparse.ArgumentParser(description="Enviro LCD GPS speed")
    parser.add_argument("--port", default=DEFAULT_PORT)
    parser.add_argument("--baud", type=int, default=DEFAULT_BAUD)
    parser.add_argument(
        "--idle-image",
        "--idle-png",
        type=Path,
        default=DEFAULT_IDLE_IMAGE,
        dest="idle_image",
        help="Image shown at 0–idle-max mph (PNG/GIF; default: fat_shy-guy.gif)",
    )
    parser.add_argument(
        "--idle-max-mph",
        type=float,
        default=DEFAULT_IDLE_MAX_MPH,
        help="Show idle image when rounded MPH is at or below this (default: 3)",
    )
    parser.add_argument(
        "--no-idle-image",
        "--no-idle-png",
        action="store_true",
        dest="no_idle_image",
        help="Always show numeric speed",
    )
    parser.add_argument(
        "--idle-gif-speed",
        type=float,
        default=DEFAULT_IDLE_GIF_SPEED,
        help="Idle GIF speed multiplier (default: 2.5)",
    )
    args = parser.parse_args()

    disp = st7735.ST7735(
        port=0,
        cs=1,
        dc=9,
        backlight=12,
        rotation=270,
        spi_speed_hz=SPI_SPEED_HZ,
    )
    disp.begin()
    disp.set_backlight(1)

    idle_frames: list[Image.Image] = []
    idle_durations: list[float] = []
    if not args.no_idle_image:
        idle_frames, idle_durations = load_idle_frames(
            args.idle_image,
            disp.width,
            disp.height,
            max(args.idle_gif_speed, 0.1),
        )

    img = Image.new("RGB", (disp.width, disp.height), BG)
    draw = ImageDraw.Draw(img)

    ser: serial.Serial | None = None
    last_mph: float | None = None
    last_speed_draw = 0.0
    last_idle_anim = 0.0
    idle_frame_index = 0
    shown_key = ""
    last_serial_open = 0.0
    SERIAL_REOPEN_SEC = 2.0

    def paint_speed_text(text: str) -> None:
        max_w = disp.width - 2 * MARGIN
        max_h = disp.height - 2 * MARGIN
        font, _tw, _th = fit_font(draw, text, max_w, max_h)
        draw.rectangle((0, 0, disp.width, disp.height), fill=BG)
        draw_text_centered(draw, text, font, disp.width, disp.height, FG)
        disp.display(img)

    def paint_idle_frame(index: int) -> None:
        if not idle_frames:
            paint_speed_text("0")
            return
        disp.display(idle_frames[index % len(idle_frames)])

    def stop(_signum=None, _frame=None) -> None:
        disp.set_backlight(0)
        if ser is not None:
            ser.close()
        sys.exit(0)

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    def close_serial() -> None:
        nonlocal ser
        if ser is None:
            return
        try:
            ser.close()
        except OSError:
            pass
        ser = None

    def open_serial() -> bool:
        nonlocal ser, last_serial_open
        close_serial()
        try:
            ser = serial.Serial(args.port, args.baud, timeout=0.15)
        except (OSError, serial.SerialException):
            ser = None
        last_serial_open = time.monotonic()
        return ser is not None

    open_serial()

    while True:
        now = time.monotonic()
        mph = last_mph
        if ser is not None:
            try:
                for _ in range(16):
                    raw = ser.readline()
                    if not raw:
                        break
                    parsed = parse_rmc_speed_mph(
                        raw.decode("ascii", errors="ignore")
                    )
                    if parsed is not None:
                        mph = parsed
            except serial.SerialException:
                close_serial()
        elif now - last_serial_open >= SERIAL_REOPEN_SEC:
            open_serial()
        last_mph = mph

        idle_enabled = not args.no_idle_image and bool(idle_frames)
        key = display_key(mph, args.idle_max_mph, idle_enabled)

        if key == "idle":
            if key != shown_key:
                idle_frame_index = 0
                last_idle_anim = now
                paint_idle_frame(0)
                shown_key = key
            elif len(idle_frames) > 1:
                step = idle_durations[idle_frame_index]
                if now - last_idle_anim >= step:
                    idle_frame_index = (idle_frame_index + 1) % len(idle_frames)
                    last_idle_anim = now
                    paint_idle_frame(idle_frame_index)
        else:
            refresh_due = (
                key != shown_key
                or now - last_speed_draw > 1.0
                and shown_key == f"text:{NO_FIX_TEXT}"
            )
            if refresh_due:
                paint_speed_text(key.removeprefix("text:"))
                shown_key = key
                last_speed_draw = now

        if key == "idle" and len(idle_frames) > 1:
            time.sleep(LOOP_SLEEP_IDLE)
        else:
            time.sleep(LOOP_SLEEP_NORMAL)


if __name__ == "__main__":
    main()
