#!/usr/bin/env python3
"""Large GPS speed on Enviro/Enviro+ LCD (full backlight)."""

from __future__ import annotations

import argparse
import signal
import sys
import time
from dataclasses import dataclass
from pathlib import Path

import ST7735 as st7735
import serial
from PIL import Image, ImageDraw, ImageFont

_MILEAGE_LIB = Path("/usr/local/lib/automotive_gps")
if _MILEAGE_LIB.is_dir():
    sys.path.insert(0, str(_MILEAGE_LIB))
else:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from mileage import MileageStore  # noqa: E402
from records import PersonalRecordsStore  # noqa: E402

KNOTS_TO_MPH = 1.15078
DEFAULT_PORT = "/dev/ttyUSB0"
DEFAULT_BAUD = 4800
DEFAULT_IDLE_DIR = Path("/usr/local/share/automotive_gps")
DEFAULT_IDLE_MANIFEST = "idle-rotation.txt"
DEFAULT_IDLE_MAX_MPH = 3.0
SPI_SPEED_HZ = 10_000_000  # Pimoroni Enviro examples; faster full-frame updates
DEFAULT_IDLE_GIF_SPEED = 2.5  # multiply GIF frame rate (1 = file timing)
IDLE_STATIC_HOLD_SEC = 2.5  # how long PNG / still frames stay up
DEFAULT_RECORDS_PAGE_SEC = 4.0
LOOP_SLEEP_IDLE = 0.008
LOOP_SLEEP_NORMAL = 0.025

# Fallback if manifest missing (best fit for 160×80: sling GIF first)
DEFAULT_IDLE_ROTATION = (
    "shyguy-with_sling.gif",
    "fat_shy-guy.gif",
    "jammin_shyguy.png",
)


@dataclass
class IdleClip:
    name: str
    frames: list[Image.Image]
    durations: list[float]

# Display (160x80 landscape after rotation=270)
MARGIN = 6
BG = (0, 0, 0)
FG = (255, 255, 255)
NO_FIX_TEXT = "--"
NO_GPS_TEXT = "--"
GPS_STALE_SEC = 5.0


def _nmea_degrees(raw: str) -> float:
    """Convert NMEA ddmm.mmmm to decimal degrees."""
    value = float(raw)
    degrees = int(value / 100)
    minutes = value - degrees * 100
    return degrees + minutes / 60.0


def parse_rmc_lat_lon(parts: list[str]) -> tuple[float, float] | None:
    if len(parts) < 7:
        return None
    lat_raw, lat_dir, lon_raw, lon_dir = (
        parts[3],
        parts[4],
        parts[5],
        parts[6],
    )
    if not lat_raw or not lon_raw or lat_dir not in ("N", "S") or lon_dir not in (
        "W",
        "E",
    ):
        return None
    try:
        lat = _nmea_degrees(lat_raw)
        lon = _nmea_degrees(lon_raw)
    except ValueError:
        return None
    if lat_dir == "S":
        lat = -lat
    if lon_dir == "W":
        lon = -lon
    return lat, lon


def parse_rmc_line(
    line: str,
) -> tuple[bool, float | None, bool, tuple[float, float] | None]:
    """Return (is_rmc, mph, fix_ok, lat_lon). mph set for A or 0.0 for V."""
    line = line.strip()
    if len(line) < 10 or line[0] != "$":
        return False, None, False, None
    if not line.split(",", 1)[0].endswith("RMC"):
        return False, None, False, None
    parts = line.split(",")
    if len(parts) < 8:
        return True, 0.0, False, None
    if parts[2] == "V":
        return True, 0.0, False, None
    if parts[2] != "A":
        return True, None, False, None
    lat_lon = parse_rmc_lat_lon(parts)
    try:
        knots = float(parts[7])
    except ValueError:
        return True, 0.0, True, lat_lon
    return True, max(0.0, knots * KNOTS_TO_MPH), True, lat_lon


def load_font(size: int) -> ImageFont.FreeTypeFont | ImageFont.ImageFont:
    try:
        from fonts.ttf import RobotoMedium as font_path

        return ImageFont.truetype(font_path, size)
    except (ImportError, OSError):
        return ImageFont.load_default()


def fit_font(
    draw: ImageDraw.ImageDraw, text: str, max_w: int, max_h: int
) -> tuple[ImageFont.FreeTypeFont | ImageFont.ImageFont, int, int]:
    for size in range(76, 18, -2):
        font = load_font(size)
        x1, y1, x2, y2 = draw.textbbox((0, 0), text, font=font)
        w, h = x2 - x1, y2 - y1
        if w <= max_w and h <= max_h:
            return font, w, h
    font = load_font(18)
    x1, y1, x2, y2 = draw.textbbox((0, 0), text, font=font)
    return font, x2 - x1, y2 - y1


def draw_text_centered(
    draw: ImageDraw.ImageDraw,
    text: str,
    font: ImageFont.FreeTypeFont | ImageFont.ImageFont,
    width: int,
    height: int,
    fill: tuple[int, int, int],
) -> None:
    """Center text in the panel (PIL uses baseline anchoring at x, y)."""
    x1, y1, x2, y2 = draw.textbbox((0, 0), text, font=font)
    x = (width - (x2 - x1)) / 2 - x1
    y = (height - (y2 - y1)) / 2 - y1
    draw.text((x, y), text, font=font, fill=fill)


def format_speed(mph: float | None, *, gps_live: bool) -> str:
    if mph is None:
        return NO_GPS_TEXT if not gps_live else "0"
    return str(int(round(mph)))


def compose_idle_frame(source: Image.Image, width: int, height: int) -> Image.Image:
    max_w = width - 2 * MARGIN
    max_h = height - 2 * MARGIN
    frame = source.copy()
    if frame.mode in ("RGBA", "LA") or (
        frame.mode == "P" and "transparency" in frame.info
    ):
        frame = frame.convert("RGBA")
        flat = Image.new("RGB", frame.size, BG)
        flat.paste(frame, mask=frame.split()[3])
        frame = flat
    else:
        frame = frame.convert("RGB")
    frame.thumbnail((max_w, max_h), Image.Resampling.LANCZOS)
    canvas = Image.new("RGB", (width, height), BG)
    x = (width - frame.width) // 2
    y = (height - frame.height) // 2
    canvas.paste(frame, (x, y))
    return canvas


def load_idle_clip(
    path: Path, width: int, height: int, gif_speed: float
) -> IdleClip | None:
    if not path.is_file():
        return None
    try:
        source = Image.open(path)
    except OSError:
        return None

    frames: list[Image.Image] = []
    durations: list[float] = []
    index = 0
    while True:
        try:
            source.seek(index)
        except EOFError:
            break
        frames.append(compose_idle_frame(source, width, height))
        ms = source.info.get("duration")
        sec = (ms or 100) / 1000.0
        if gif_speed > 0:
            sec /= gif_speed
        durations.append(max(sec, 0.02))
        index += 1

    if not frames:
        return None
    if len(frames) == 1:
        durations = [max(IDLE_STATIC_HOLD_SEC, 0.5)]
    elif len(durations) < len(frames):
        durations.extend([0.1] * (len(frames) - len(durations)))
    return IdleClip(name=path.name, frames=frames, durations=durations)


def read_idle_manifest(idle_dir: Path) -> list[str]:
    manifest = idle_dir / DEFAULT_IDLE_MANIFEST
    names: list[str] = []
    if manifest.is_file():
        for line in manifest.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                names.append(line)
    if names:
        return names
    return list(DEFAULT_IDLE_ROTATION)


def load_idle_playlist(
    idle_dir: Path,
    width: int,
    height: int,
    gif_speed: float,
    single: Path | None,
) -> list[IdleClip]:
    if single is not None:
        clip = load_idle_clip(single, width, height, gif_speed)
        return [clip] if clip else []

    clips: list[IdleClip] = []
    for name in read_idle_manifest(idle_dir):
        clip = load_idle_clip(idle_dir / name, width, height, gif_speed)
        if clip is not None:
            clips.append(clip)
    return clips


def format_sec(value: float | None) -> str:
    if value is None:
        return "--"
    return f"{value:.1f}s"


def display_key(
    mph: float | None,
    idle_max_mph: float,
    idle_enabled: bool,
    *,
    gps_live: bool,
) -> str:
    text = format_speed(mph, gps_live=gps_live)
    if text == NO_GPS_TEXT:
        return f"text:{NO_GPS_TEXT}"
    shown = int(text)
    if idle_enabled and shown <= int(round(idle_max_mph)):
        return "idle"
    if shown == 0 and gps_live:
        return "records"
    return f"text:{text}"


def main() -> None:
    parser = argparse.ArgumentParser(description="Enviro LCD GPS speed")
    parser.add_argument("--port", default=DEFAULT_PORT)
    parser.add_argument("--baud", type=int, default=DEFAULT_BAUD)
    parser.add_argument(
        "--idle-image",
        "--idle-png",
        type=Path,
        default=None,
        dest="idle_image",
        help="Optional PNG/GIF at 0–idle-max mph (default: personal records at 0 mph)",
    )
    parser.add_argument(
        "--idle-dir",
        type=Path,
        default=DEFAULT_IDLE_DIR,
        help="Directory for idle-rotation.txt and assets (default: share dir)",
    )
    parser.add_argument(
        "--idle-max-mph",
        type=float,
        default=DEFAULT_IDLE_MAX_MPH,
        help="Show idle image when rounded MPH is at or below this (default: 3)",
    )
    parser.add_argument(
        "--no-idle-image",
        "--no-idle-png",
        action="store_true",
        dest="no_idle_image",
        help="Always show numeric speed",
    )
    parser.add_argument(
        "--idle-gif-speed",
        type=float,
        default=DEFAULT_IDLE_GIF_SPEED,
        help="Idle GIF speed multiplier (default: 2.5)",
    )
    parser.add_argument(
        "--no-mileage",
        action="store_true",
        help="Do not record distance to Redis/JSON",
    )
    parser.add_argument(
        "--records-page-sec",
        type=float,
        default=DEFAULT_RECORDS_PAGE_SEC,
        help="Seconds per stats page at 0 mph (default: 4)",
    )
    args = parser.parse_args()

    disp = st7735.ST7735(
        port=0,
        cs=1,
        dc=9,
        backlight=12,
        rotation=270,
        spi_speed_hz=SPI_SPEED_HZ,
    )
    disp.begin()
    disp.set_backlight(1)

    img = Image.new("RGB", (disp.width, disp.height), BG)
    draw = ImageDraw.Draw(img)

    use_idle_art = bool(args.idle_image) and not args.no_idle_image
    idle_clips: list[IdleClip] = []
    idle_clips_loaded = not use_idle_art
    gif_speed = max(args.idle_gif_speed, 0.1)

    mileage: MileageStore | None = None
    records: PersonalRecordsStore | None = None
    last_mileage_flush = time.monotonic()
    last_records_flush = time.monotonic()

    ser: serial.Serial | None = None
    last_mph: float | None = None
    last_lat_lon: tuple[float, float] | None = None
    last_fix_ok = False
    last_rmc_at = 0.0
    last_speed_draw = 0.0
    records_page = 0
    last_records_page_flip = 0.0
    last_idle_anim = 0.0
    idle_clip_index = 0
    idle_frame_index = 0
    shown_key = ""
    last_serial_open = 0.0
    SERIAL_REOPEN_SEC = 2.0

    def paint_speed_text(text: str) -> None:
        max_w = disp.width - 2 * MARGIN
        max_h = disp.height - 2 * MARGIN
        font, _tw, _th = fit_font(draw, text, max_w, max_h)
        draw.rectangle((0, 0, disp.width, disp.height), fill=BG)
        draw_text_centered(draw, text, font, disp.width, disp.height, FG)
        disp.display(img)

    def paint_personal_records(page: int) -> None:
        draw.rectangle((0, 0, disp.width, disp.height), fill=BG)
        odometer = int(round(mileage.odometer_miles)) if mileage else 0
        page = page % 2

        if page == 1:
            label_font = load_font(16)
            if records is None:
                value_text = "--"
            else:
                value_text = format_sec(records.best_twenty_sixty_sec)
            draw.text((8, 6), "20-60", font=label_font, fill=(140, 140, 140))
            max_w = disp.width - 2 * MARGIN
            value_top = 22
            max_h = disp.height - value_top - MARGIN
            font, _tw, th = fit_font(draw, value_text, max_w, max_h)
            x1, y1, x2, y2 = draw.textbbox((0, 0), value_text, font=font)
            tw, th = x2 - x1, y2 - y1
            x = (disp.width - tw) / 2 - x1
            y = value_top + (max_h - th) / 2 - y1
            draw.text((x, y), value_text, font=font, fill=FG)
            disp.display(img)
            return

        if records is None:
            rows = [
                ("1/8", "--"),
                ("0-60", "--"),
                ("TOP", "--"),
                ("MI", str(odometer)),
            ]
        else:
            rows = [
                ("1/8", format_sec(records.best_eighth_mile_sec)),
                ("0-60", format_sec(records.best_zero_sixty_sec)),
                ("TOP", str(int(round(records.top_speed_mph)))),
                ("MI", str(odometer)),
            ]
        label_font = load_font(14)
        value_font = load_font(17)
        y = 5
        for label, value in rows:
            draw.text((6, y), label, font=label_font, fill=(140, 140, 140))
            draw.text((72, y - 1), value, font=value_font, fill=FG)
            y += 19
        disp.display(img)

    def ensure_idle_clips() -> None:
        nonlocal idle_clips, idle_clips_loaded
        if idle_clips_loaded:
            return
        idle_clips = load_idle_playlist(
            args.idle_dir,
            disp.width,
            disp.height,
            gif_speed,
            args.idle_image,
        )
        idle_clips_loaded = True

    def paint_idle_at(clip_index: int, frame_index: int) -> None:
        if not idle_clips:
            paint_speed_text("0")
            return
        clip = idle_clips[clip_index % len(idle_clips)]
        disp.display(clip.frames[frame_index % len(clip.frames)])

    def reset_idle_playback() -> None:
        nonlocal idle_clip_index, idle_frame_index, last_idle_anim
        idle_clip_index = 0
        idle_frame_index = 0
        last_idle_anim = time.monotonic()
        paint_idle_at(0, 0)

    def tick_idle_animation(now: float) -> None:
        nonlocal idle_clip_index, idle_frame_index, last_idle_anim
        if not idle_clips:
            return
        clip = idle_clips[idle_clip_index]
        step = clip.durations[idle_frame_index]
        if now - last_idle_anim < step:
            return
        last_idle_anim = now
        idle_frame_index += 1
        if idle_frame_index >= len(clip.frames):
            idle_clip_index = (idle_clip_index + 1) % len(idle_clips)
            idle_frame_index = 0
        paint_idle_at(idle_clip_index, idle_frame_index)

    def stop(_signum=None, _frame=None) -> None:
        disp.set_backlight(0)
        if ser is not None:
            ser.close()
        if mileage is not None:
            mileage.flush()
        if records is not None:
            records.flush()
        sys.exit(0)

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    def close_serial() -> None:
        nonlocal ser
        if ser is None:
            return
        try:
            ser.close()
        except OSError:
            pass
        ser = None

    def open_serial() -> bool:
        nonlocal ser, last_serial_open
        close_serial()
        try:
            ser = serial.Serial(
                args.port,
                args.baud,
                timeout=0.15,
                rtscts=False,
                dsrdtr=False,
            )
            ser.dtr = True
            ser.rts = False
            ser.reset_input_buffer()
        except (OSError, serial.SerialException):
            ser = None
        last_serial_open = time.monotonic()
        return ser is not None

    paint_speed_text(NO_FIX_TEXT)

    if not args.no_mileage:
        try:
            mileage = MileageStore()
        except OSError:
            mileage = None
    try:
        records = PersonalRecordsStore()
    except OSError:
        records = None

    open_serial()

    while True:
        now = time.monotonic()
        mph = last_mph
        if ser is not None:
            try:
                for _ in range(16):
                    raw = ser.readline()
                    if not raw:
                        break
                    is_rmc, parsed, fix_ok, lat_lon = parse_rmc_line(
                        raw.decode("ascii", errors="ignore")
                    )
                    if is_rmc:
                        sample_at = time.monotonic()
                        last_rmc_at = sample_at
                        last_fix_ok = fix_ok
                        if lat_lon is not None:
                            last_lat_lon = lat_lon
                        if parsed is not None:
                            mph = parsed
                        if fix_ok and parsed is not None:
                            rlat = rlon = None
                            if lat_lon is not None:
                                rlat, rlon = lat_lon
                            if mileage is not None and rlat is not None and rlon is not None:
                                mileage.tick(
                                    parsed,
                                    sample_at,
                                    lat=rlat,
                                    lon=rlon,
                                    fix_ok=True,
                                )
                                if mileage.maybe_flush(
                                    sample_at, last_mileage_flush
                                ):
                                    last_mileage_flush = sample_at
                            if records is not None:
                                records.tick_speed(
                                    parsed,
                                    sample_at,
                                    fix_ok=True,
                                    lat=rlat,
                                    lon=rlon,
                                )
                                if records.maybe_flush(
                                    sample_at, last_records_flush
                                ):
                                    last_records_flush = sample_at
            except serial.SerialException:
                close_serial()
        elif now - last_serial_open >= SERIAL_REOPEN_SEC:
            open_serial()
        last_mph = mph

        gps_live = (now - last_rmc_at) <= GPS_STALE_SEC
        display_mph = mph if gps_live else None

        if use_idle_art:
            ensure_idle_clips()
        idle_enabled = use_idle_art and bool(idle_clips)
        key = display_key(
            display_mph,
            args.idle_max_mph,
            idle_enabled,
            gps_live=gps_live,
        )

        if key == "records":
            page_sec = max(args.records_page_sec, 1.0)
            if key != shown_key:
                records_page = 0
                last_records_page_flip = now
                paint_personal_records(records_page)
                shown_key = key
                last_speed_draw = now
            else:
                if now - last_records_page_flip >= page_sec:
                    records_page = (records_page + 1) % 2
                    last_records_page_flip = now
                    paint_personal_records(records_page)
                    last_speed_draw = now
                elif now - last_speed_draw >= 2.0:
                    paint_personal_records(records_page)
                    last_speed_draw = now
        elif key == "idle":
            if key != shown_key:
                reset_idle_playback()
                shown_key = key
            else:
                tick_idle_animation(now)
        else:
            refresh_due = (
                key != shown_key
                or now - last_speed_draw > 1.0
                and shown_key == f"text:{NO_FIX_TEXT}"
            )
            if refresh_due:
                paint_speed_text(key.removeprefix("text:"))
                shown_key = key
                last_speed_draw = now

        if key == "idle" and idle_clips:
            time.sleep(LOOP_SLEEP_IDLE)
        elif key == "records":
            time.sleep(0.15)
        else:
            time.sleep(LOOP_SLEEP_NORMAL)


if __name__ == "__main__":
    main()
