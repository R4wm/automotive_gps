#!/usr/bin/env python3
"""Large GPS speed on Enviro/Enviro+ LCD (full backlight)."""

from __future__ import annotations

import argparse
import os
import signal
import sys
import time
from dataclasses import dataclass
from pathlib import Path

import ST7735 as st7735
import serial
from PIL import Image, ImageDraw, ImageFont

_MILEAGE_LIB = Path("/usr/local/lib/automotive_gps")
if _MILEAGE_LIB.is_dir():
    sys.path.insert(0, str(_MILEAGE_LIB))
else:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from mileage import MAX_SAMPLE_GAP_SEC, MileageStore  # noqa: E402
from gps_rmc import parse_rmc_line, parse_rmc_timestamp  # noqa: E402
from records import (  # noqa: E402
    RECORD_KINDS,
    RECORD_LABELS,
    NewRecord,
    PersonalRecordsStore,
)

DEFAULT_PORT = "/dev/ttyUSB0"
DEFAULT_BAUD = 4800
DEFAULT_IDLE_DIR = Path("/usr/local/share/automotive_gps")
DEFAULT_IDLE_MANIFEST = "idle-rotation.txt"
DEFAULT_IDLE_MAX_MPH = 3.0
SPI_SPEED_HZ = 10_000_000  # Pimoroni Enviro examples; faster full-frame updates
DEFAULT_IDLE_GIF_SPEED = 2.5  # multiply GIF frame rate (1 = file timing)
IDLE_STATIC_HOLD_SEC = 2.5  # how long PNG / still frames stay up
DEFAULT_STATS_PAGE_SEC = 4.0
STATS_PAGE_COUNT = 3  # mileage, today's records, best-ever records
DEFAULT_RECORD_IMAGE = DEFAULT_IDLE_DIR / "jammin_shyguy.png"
DEFAULT_RECORD_IMAGE_SEC = 3.0
LOOP_SLEEP_IDLE = 0.008
LOOP_SLEEP_NORMAL = 0.025

# Fallback if manifest missing (best fit for 160×80: sling GIF first)
DEFAULT_IDLE_ROTATION = (
    "shyguy-with_sling.gif",
    "fat_shy-guy.gif",
    "jammin_shyguy.png",
)


@dataclass
class IdleClip:
    name: str
    frames: list[Image.Image]
    durations: list[float]

# Display (160x80 landscape after rotation=270)
MARGIN = 6
BG = (0, 0, 0)
FG = (255, 255, 255)
NO_FIX_TEXT = "--"
NO_GPS_TEXT = "--"
GPS_STALE_SEC = 5.0


def load_font(size: int) -> ImageFont.FreeTypeFont | ImageFont.ImageFont:
    try:
        from fonts.ttf import RobotoMedium as font_path

        return ImageFont.truetype(font_path, size)
    except (ImportError, OSError):
        return ImageFont.load_default()


def fit_font(
    draw: ImageDraw.ImageDraw, text: str, max_w: int, max_h: int
) -> tuple[ImageFont.FreeTypeFont | ImageFont.ImageFont, int, int]:
    for size in range(76, 18, -2):
        font = load_font(size)
        x1, y1, x2, y2 = draw.textbbox((0, 0), text, font=font)
        w, h = x2 - x1, y2 - y1
        if w <= max_w and h <= max_h:
            return font, w, h
    font = load_font(18)
    x1, y1, x2, y2 = draw.textbbox((0, 0), text, font=font)
    return font, x2 - x1, y2 - y1


def draw_text_centered(
    draw: ImageDraw.ImageDraw,
    text: str,
    font: ImageFont.FreeTypeFont | ImageFont.ImageFont,
    width: int,
    height: int,
    fill: tuple[int, int, int],
) -> None:
    """Center text in the panel (PIL uses baseline anchoring at x, y)."""
    x1, y1, x2, y2 = draw.textbbox((0, 0), text, font=font)
    x = (width - (x2 - x1)) / 2 - x1
    y = (height - (y2 - y1)) / 2 - y1
    draw.text((x, y), text, font=font, fill=fill)


def format_speed(mph: float | None, *, gps_live: bool) -> str:
    if mph is None:
        return NO_GPS_TEXT if not gps_live else "0"
    return str(int(round(mph)))


def format_sec(value: float | None) -> str:
    if value is None:
        return "--"
    return f"{value:.1f}s"


def compose_idle_frame(source: Image.Image, width: int, height: int) -> Image.Image:
    max_w = width - 2 * MARGIN
    max_h = height - 2 * MARGIN
    frame = source.copy()
    if frame.mode in ("RGBA", "LA") or (
        frame.mode == "P" and "transparency" in frame.info
    ):
        frame = frame.convert("RGBA")
        flat = Image.new("RGB", frame.size, BG)
        flat.paste(frame, mask=frame.split()[3])
        frame = flat
    else:
        frame = frame.convert("RGB")
    frame.thumbnail((max_w, max_h), Image.Resampling.LANCZOS)
    canvas = Image.new("RGB", (width, height), BG)
    x = (width - frame.width) // 2
    y = (height - frame.height) // 2
    canvas.paste(frame, (x, y))
    return canvas


def load_idle_clip(
    path: Path, width: int, height: int, gif_speed: float
) -> IdleClip | None:
    if not path.is_file():
        return None
    try:
        source = Image.open(path)
    except OSError:
        return None

    frames: list[Image.Image] = []
    durations: list[float] = []
    index = 0
    while True:
        try:
            source.seek(index)
        except EOFError:
            break
        frames.append(compose_idle_frame(source, width, height))
        ms = source.info.get("duration")
        sec = (ms or 100) / 1000.0
        if gif_speed > 0:
            sec /= gif_speed
        durations.append(max(sec, 0.02))
        index += 1

    if not frames:
        return None
    if len(frames) == 1:
        durations = [max(IDLE_STATIC_HOLD_SEC, 0.5)]
    elif len(durations) < len(frames):
        durations.extend([0.1] * (len(frames) - len(durations)))
    return IdleClip(name=path.name, frames=frames, durations=durations)


def read_idle_manifest(idle_dir: Path) -> list[str]:
    manifest = idle_dir / DEFAULT_IDLE_MANIFEST
    names: list[str] = []
    if manifest.is_file():
        for line in manifest.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#"):
                names.append(line)
    if names:
        return names
    return list(DEFAULT_IDLE_ROTATION)


def load_idle_playlist(
    idle_dir: Path,
    width: int,
    height: int,
    gif_speed: float,
    single: Path | None,
) -> list[IdleClip]:
    if single is not None:
        clip = load_idle_clip(single, width, height, gif_speed)
        return [clip] if clip else []

    clips: list[IdleClip] = []
    for name in read_idle_manifest(idle_dir):
        clip = load_idle_clip(idle_dir / name, width, height, gif_speed)
        if clip is not None:
            clips.append(clip)
    return clips


def display_key(
    mph: float | None,
    idle_max_mph: float,
    idle_enabled: bool,
    *,
    gps_live: bool,
) -> str:
    text = format_speed(mph, gps_live=gps_live)
    if text == NO_GPS_TEXT:
        return f"text:{NO_GPS_TEXT}"
    shown = int(text)
    if idle_enabled and shown <= int(round(idle_max_mph)):
        return "idle"
    if shown == 0 and gps_live:
        return "stats"
    return f"text:{text}"


def main() -> None:
    parser = argparse.ArgumentParser(description="Enviro LCD GPS speed")
    parser.add_argument("--port", default=DEFAULT_PORT)
    parser.add_argument("--baud", type=int, default=DEFAULT_BAUD)
    parser.add_argument(
        "--idle-image",
        "--idle-png",
        type=Path,
        default=None,
        dest="idle_image",
        help="Optional PNG/GIF at 0–idle-max mph (default: mileage and records at 0 mph)",
    )
    parser.add_argument(
        "--idle-dir",
        type=Path,
        default=DEFAULT_IDLE_DIR,
        help="Directory for idle-rotation.txt and assets (default: share dir)",
    )
    parser.add_argument(
        "--idle-max-mph",
        type=float,
        default=DEFAULT_IDLE_MAX_MPH,
        help="Show idle image when rounded MPH is at or below this (default: 3)",
    )
    parser.add_argument(
        "--no-idle-image",
        "--no-idle-png",
        action="store_true",
        dest="no_idle_image",
        help="Always show numeric speed",
    )
    parser.add_argument(
        "--idle-gif-speed",
        type=float,
        default=DEFAULT_IDLE_GIF_SPEED,
        help="Idle GIF speed multiplier (default: 2.5)",
    )
    parser.add_argument(
        "--no-mileage",
        action="store_true",
        help="Do not record distance to Redis/JSON",
    )
    parser.add_argument(
        "--no-records",
        action="store_true",
        help="Do not track 1/8 mile, 0-60 and 20-60 records",
    )
    parser.add_argument(
        "--stats-page-sec",
        "--records-page-sec",
        type=float,
        default=DEFAULT_STATS_PAGE_SEC,
        dest="stats_page_sec",
        help="Seconds per stats page at 0 mph (default: 4)",
    )
    parser.add_argument(
        "--record-image",
        type=Path,
        default=DEFAULT_RECORD_IMAGE,
        help="Image shown with a new daily or best-ever record",
    )
    parser.add_argument(
        "--record-image-sec",
        type=float,
        default=DEFAULT_RECORD_IMAGE_SEC,
        help="Seconds to show each new record at the next stop (0 disables; default: 3)",
    )
    args = parser.parse_args()

    disp = st7735.ST7735(
        port=0,
        cs=1,
        dc=9,
        backlight=12,
        rotation=270,
        spi_speed_hz=SPI_SPEED_HZ,
    )
    disp.begin()
    disp.set_backlight(1)

    img = Image.new("RGB", (disp.width, disp.height), BG)
    draw = ImageDraw.Draw(img)

    use_idle_art = bool(args.idle_image) and not args.no_idle_image
    idle_clips: list[IdleClip] = []
    idle_clips_loaded = not use_idle_art
    gif_speed = max(args.idle_gif_speed, 0.1)

    mileage: MileageStore | None = None
    last_mileage_flush = time.monotonic()
    records: PersonalRecordsStore | None = None
    celebrations: list[NewRecord] = []
    celebrate_until = 0.0
    record_badge: Image.Image | None = None
    stats_page = 0
    last_stats_page_flip = 0.0

    ser: serial.Serial | None = None
    last_mph: float | None = None
    last_rmc_at = 0.0
    last_speed_draw = 0.0
    last_idle_anim = 0.0
    idle_clip_index = 0
    idle_frame_index = 0
    shown_key = ""
    last_serial_open = 0.0
    SERIAL_REOPEN_SEC = 2.0

    def paint_speed_text(text: str) -> None:
        max_w = disp.width - 2 * MARGIN
        max_h = disp.height - 2 * MARGIN
        font, _tw, _th = fit_font(draw, text, max_w, max_h)
        draw.rectangle((0, 0, disp.width, disp.height), fill=BG)
        draw_text_centered(draw, text, font, disp.width, disp.height, FG)
        disp.display(img)

    def paint_mileage() -> None:
        draw.rectangle((0, 0, disp.width, disp.height), fill=BG)
        label_font = load_font(14)
        rows = (
            ("MI", f"{mileage.odometer_miles:.2f}" if mileage else "--"),
            ("TRIP", f"{mileage.trip_miles:.2f}" if mileage else "--"),
        )
        for y, (label, value) in zip((5, 43), rows):
            draw.text((6, y), label, font=label_font, fill=(140, 140, 140))
            font, _, _ = fit_font(draw, value, disp.width - 54, 30)
            x1, y1, _, _ = draw.textbbox((0, 0), value, font=font)
            draw.text((54 - x1, y - y1), value, font=font, fill=FG)
        disp.display(img)

    def paint_records(title: str, values: dict[str, float | None]) -> None:
        draw.rectangle((0, 0, disp.width, disp.height), fill=BG)
        label_font = load_font(14)
        value_font = load_font(17)
        draw.text((6, 5), title, font=label_font, fill=(140, 140, 140))
        for y, kind in zip((24, 43, 62), RECORD_KINDS):
            draw.text((6, y), RECORD_LABELS[kind], font=label_font, fill=(140, 140, 140))
            draw.text((72, y - 1), format_sec(values[kind]), font=value_font, fill=FG)
        disp.display(img)

    def paint_stats(page: int) -> None:
        page %= STATS_PAGE_COUNT
        if page == 0 or records is None:
            paint_mileage()
        elif page == 1:
            paint_records("TODAY", records.today)
        else:
            paint_records("BEST EVER", records.best)

    def paint_celebration(record: NewRecord) -> None:
        nonlocal record_badge
        if record_badge is None:
            badge = load_idle_clip(args.record_image, disp.height, disp.height, 1.0)
            record_badge = badge.frames[0] if badge else Image.new("RGB", (1, 1), BG)
        draw.rectangle((0, 0, disp.width, disp.height), fill=BG)
        img.paste(record_badge, (0, 0))
        left = disp.height + 2 if record_badge.width > 1 else MARGIN
        max_w = disp.width - left - MARGIN
        header = "NEW BEST" if record.scope == "best" else "TODAY"
        draw.text((left, 4), header, font=load_font(14), fill=(255, 200, 0))
        draw.text((left, 22), RECORD_LABELS[record.kind], font=load_font(17), fill=FG)
        value = format_sec(record.seconds)
        font, _, _ = fit_font(draw, value, max_w, 32)
        x1, y1, _, _ = draw.textbbox((0, 0), value, font=font)
        draw.text((left - x1, 44 - y1), value, font=font, fill=FG)
        disp.display(img)

    def ensure_idle_clips() -> None:
        nonlocal idle_clips, idle_clips_loaded
        if idle_clips_loaded:
            return
        idle_clips = load_idle_playlist(
            args.idle_dir,
            disp.width,
            disp.height,
            gif_speed,
            args.idle_image,
        )
        idle_clips_loaded = True

    def paint_idle_at(clip_index: int, frame_index: int) -> None:
        if not idle_clips:
            paint_speed_text("0")
            return
        clip = idle_clips[clip_index % len(idle_clips)]
        disp.display(clip.frames[frame_index % len(clip.frames)])

    def reset_idle_playback() -> None:
        nonlocal idle_clip_index, idle_frame_index, last_idle_anim
        idle_clip_index = 0
        idle_frame_index = 0
        last_idle_anim = time.monotonic()
        paint_idle_at(0, 0)

    def tick_idle_animation(now: float) -> None:
        nonlocal idle_clip_index, idle_frame_index, last_idle_anim
        if not idle_clips:
            return
        clip = idle_clips[idle_clip_index]
        step = clip.durations[idle_frame_index]
        if now - last_idle_anim < step:
            return
        last_idle_anim = now
        idle_frame_index += 1
        if idle_frame_index >= len(clip.frames):
            idle_clip_index = (idle_clip_index + 1) % len(idle_clips)
            idle_frame_index = 0
        paint_idle_at(idle_clip_index, idle_frame_index)

    def stop(_signum=None, _frame=None) -> None:
        disp.set_backlight(0)
        if ser is not None:
            ser.close()
        if mileage is not None:
            mileage.flush()
        if records is not None:
            records.flush()
        sys.exit(0)

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    def close_serial() -> None:
        nonlocal ser
        if ser is None:
            return
        try:
            ser.close()
        except OSError:
            pass
        ser = None

    def open_serial() -> bool:
        nonlocal ser, last_serial_open
        close_serial()
        try:
            ser = serial.Serial(
                args.port,
                args.baud,
                timeout=0.15,
                rtscts=False,
                dsrdtr=False,
            )
            ser.dtr = True
            ser.rts = False
            ser.reset_input_buffer()
        except (OSError, serial.SerialException):
            ser = None
        last_serial_open = time.monotonic()
        return ser is not None

    paint_speed_text(NO_FIX_TEXT)

    if not args.no_mileage and os.environ.get("MILEAGE_DISABLE", "").lower() not in ("1", "true", "yes"):
        try:
            mileage = MileageStore()
        except OSError:
            mileage = None
    if not args.no_records:
        try:
            records = PersonalRecordsStore()
        except OSError:
            records = None
    open_serial()

    while True:
        now = time.monotonic()
        mph = last_mph
        if ser is not None:
            try:
                for _ in range(16):
                    raw = ser.readline()
                    if not raw:
                        break
                    line = raw.decode("ascii", errors="replace")
                    is_rmc, parsed, fix_ok, lat_lon = parse_rmc_line(line)
                    if is_rmc:
                        sample_at = time.monotonic()
                        last_rmc_at = sample_at
                        if not fix_ok:
                            mph = None
                            if mileage is not None:
                                mileage.invalidate_sample()
                            if records is not None:
                                records.invalidate_sample()
                        if parsed is not None:
                            mph = parsed
                        if fix_ok and parsed is not None:
                            rlat = rlon = None
                            if lat_lon is not None:
                                rlat, rlon = lat_lon
                            fix_at = parse_rmc_timestamp(line)
                            if mileage is not None and rlat is not None and rlon is not None:
                                mileage.tick(
                                    parsed,
                                    fix_at,
                                    lat=rlat,
                                    lon=rlon,
                                    fix_ok=True,
                                )
                            if records is not None:
                                celebrations.extend(
                                    records.tick(
                                        parsed,
                                        fix_at,
                                        lat=rlat,
                                        lon=rlon,
                                        fix_ok=True,
                                    )
                                )
            except serial.SerialException:
                close_serial()
                if mileage is not None:
                    mileage.invalidate_sample()
                if records is not None:
                    records.invalidate_sample()
        elif now - last_serial_open >= SERIAL_REOPEN_SEC:
            open_serial()
        last_mph = mph

        now = time.monotonic()
        if now - last_rmc_at > MAX_SAMPLE_GAP_SEC:
            if mileage is not None:
                mileage.invalidate_sample()
            if records is not None:
                records.invalidate_sample()
        if mileage is not None and mileage.maybe_flush(now, last_mileage_flush):
            last_mileage_flush = now
        if records is not None:
            records.maybe_flush()
        gps_live = (now - last_rmc_at) <= GPS_STALE_SEC
        display_mph = mph if gps_live else None

        if use_idle_art:
            ensure_idle_clips()
        idle_enabled = use_idle_art and bool(idle_clips)
        key = display_key(
            display_mph,
            args.idle_max_mph,
            idle_enabled,
            gps_live=gps_live,
        )

        # Show new records at the next stop, never over the speedometer.
        # Runs are timed from GPS timestamps, so drawing here never changes
        # a measured time.
        if args.record_image_sec <= 0:
            celebrations.clear()
        stopped = (
            display_mph is not None
            and int(round(display_mph)) <= int(round(args.idle_max_mph))
        )
        if not stopped:
            celebrate_until = 0.0
        elif now >= celebrate_until and celebrations:
            paint_celebration(celebrations.pop(0))
            celebrate_until = now + args.record_image_sec
            shown_key = "record"
        if now < celebrate_until:
            key = "record"

        if key == "record":
            pass
        elif key == "stats":
            page_sec = max(args.stats_page_sec, 1.0)
            if key != shown_key:
                stats_page = 0
                last_stats_page_flip = now
                paint_stats(stats_page)
                shown_key = key
                last_speed_draw = now
            elif now - last_stats_page_flip >= page_sec:
                stats_page = (stats_page + 1) % STATS_PAGE_COUNT
                last_stats_page_flip = now
                paint_stats(stats_page)
                last_speed_draw = now
            elif now - last_speed_draw >= 2.0:
                paint_stats(stats_page)
                last_speed_draw = now
        elif key == "idle":
            if key != shown_key:
                reset_idle_playback()
                shown_key = key
            else:
                tick_idle_animation(now)
        else:
            refresh_due = (
                key != shown_key
                or now - last_speed_draw > 1.0
                and shown_key == f"text:{NO_FIX_TEXT}"
            )
            if refresh_due:
                paint_speed_text(key.removeprefix("text:"))
                shown_key = key
                last_speed_draw = now

        if key == "idle" and idle_clips:
            time.sleep(LOOP_SLEEP_IDLE)
        elif key == "stats":
            time.sleep(0.15)
        else:
            time.sleep(LOOP_SLEEP_NORMAL)


if __name__ == "__main__":
    main()
