#!/usr/bin/env python3
"""Step through ST7735 invert/bgr settings; pick black bg + white text."""

import sys
import time

import RPi.GPIO as GPIO
import ST7735 as st7735
from PIL import Image, ImageDraw, ImageFont

BACKLIGHT_PIN = 12
MODES = (
    (True, True, "1/4 invert=1 bgr=1 (Pimoroni default)"),
    (True, False, "2/4 invert=1 bgr=0"),
    (False, True, "3/4 invert=0 bgr=1"),
    (False, False, "4/4 invert=0 bgr=0"),
)


def prepare_backlight_pin() -> None:
    GPIO.setwarnings(False)
    if GPIO.getmode() is None:
        GPIO.setmode(GPIO.BCM)
    GPIO.setup(BACKLIGHT_PIN, GPIO.OUT)
    GPIO.output(BACKLIGHT_PIN, GPIO.HIGH)


def show(invert: bool, bgr: bool, label: str) -> None:
    prepare_backlight_pin()
    disp = st7735.ST7735(
        port=0,
        cs=1,
        dc=9,
        backlight=BACKLIGHT_PIN,
        rotation=270,
        spi_speed_hz=4000000,
        invert=invert,
        bgr=bgr,
    )
    disp.begin()
    disp.set_backlight(1)
    img = Image.new("RGB", (disp.width, disp.height), (0, 0, 0))
    draw = ImageDraw.Draw(img)
    try:
        from fonts.ttf import RobotoMedium as font_path

        font = ImageFont.truetype(font_path, 28)
    except (ImportError, OSError):
        font = ImageFont.load_default()
    draw.text((6, 4), label, font=font, fill=(255, 255, 255))
    draw.text((40, 40), "55", font=font, fill=(255, 255, 255))
    disp.display(img)
    print(label)
    print("  Want this look? Add to /etc/default/enviro-gps-speed:")
    print(f"  ST7735_INVERT={'1' if invert else '0'}")
    print(f"  ST7735_BGR={'1' if bgr else '0'}")
    print()


def main() -> None:
    print("Each mode shows for 8 seconds (black bg, white text goal). Ctrl+C to stop.\n")
    try:
        for invert, bgr, label in MODES:
            show(invert, bgr, label)
            time.sleep(8)
    except KeyboardInterrupt:
        pass
    print("Then: systemctl restart enviro-gps-speed")
    sys.exit(0)


if __name__ == "__main__":
    main()
