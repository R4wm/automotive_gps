#!/usr/bin/env python3
"""Show mileage and personal records from enviro-gps-speed (Redis + JSON)."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

_LIB = Path("/usr/local/lib/automotive_gps")
if _LIB.is_dir():
    sys.path.insert(0, str(_LIB))
else:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from mileage import DEFAULT_STATE_PATH, MileageStore, load_snapshot  # noqa: E402
from records import DEFAULT_STATE_PATH as RECORDS_PATH  # noqa: E402
from records import PersonalRecordsStore  # noqa: E402


def fmt_sec(value: float | None) -> str:
    if value is None:
        return "--"
    return f"{value:.2f}s"


def main() -> None:
    parser = argparse.ArgumentParser(description="Automotive GPS mileage & records")
    parser.add_argument(
        "--state-file",
        type=Path,
        default=DEFAULT_STATE_PATH,
        help="Mileage JSON path",
    )
    parser.add_argument(
        "--records-file",
        type=Path,
        default=RECORDS_PATH,
        help="Personal records JSON path",
    )
    parser.add_argument(
        "--export",
        action="store_true",
        help="Print combined JSON (for upload)",
    )
    parser.add_argument(
        "--reset-trip",
        action="store_true",
        help="Zero trip_miles (odometer unchanged)",
    )
    args = parser.parse_args()

    if args.reset_trip:
        store = MileageStore(state_path=args.state_file)
        store.reset_trip()
        print("Trip miles reset.")
        return

    mileage = load_snapshot(state_path=args.state_file)
    records = PersonalRecordsStore(state_path=args.records_file).snapshot()

    if args.export:
        print(json.dumps({"mileage": mileage, "records": records}, indent=2))
        return

    print(f"Device:    {mileage['device_id']}")
    print(f"Odometer:  {mileage['odometer_miles']:.2f} mi")
    print(f"Trip:      {mileage['trip_miles']:.2f} mi")
    print(f"0-60:      {fmt_sec(records.get('best_zero_sixty_sec'))}")
    print(f"20-60:     {fmt_sec(records.get('best_twenty_sixty_sec'))}")
    print(f"Top speed: {records.get('top_speed_mph', 0):.0f} mph")
    print(f"Updated:   {mileage['updated_at']}")
    print(f"State:     {args.state_file}")


if __name__ == "__main__":
    main()
