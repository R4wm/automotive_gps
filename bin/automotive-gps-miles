#!/usr/bin/env python3
"""Show or export mileage stored by enviro-gps-speed (Redis + JSON)."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

_LIB = Path("/usr/local/lib/automotive_gps")
if _LIB.is_dir():
    sys.path.insert(0, str(_LIB))
else:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from mileage import DEFAULT_STATE_PATH, MileageStore, load_snapshot  # noqa: E402


def main() -> None:
    parser = argparse.ArgumentParser(description="Automotive GPS mileage")
    parser.add_argument(
        "--state-file",
        type=Path,
        default=DEFAULT_STATE_PATH,
        help="Local JSON backup path",
    )
    parser.add_argument(
        "--export",
        action="store_true",
        help="Print full JSON (for upload)",
    )
    parser.add_argument(
        "--reset-trip",
        action="store_true",
        help="Zero trip_miles (odometer unchanged)",
    )
    args = parser.parse_args()

    if args.reset_trip:
        store = MileageStore(state_path=args.state_file)
        store.reset_trip()
        print("Trip miles reset.")
        return

    snap = load_snapshot(state_path=args.state_file)
    if args.export:
        print(json.dumps(snap, indent=2))
        return

    print(f"Device:    {snap['device_id']}")
    print(f"Odometer:  {snap['odometer_miles']:.2f} mi")
    print(f"Trip:      {snap['trip_miles']:.2f} mi")
    print(f"Updated:   {snap['updated_at']}")
    print(f"State file: {args.state_file}")


if __name__ == "__main__":
    main()
