#!/usr/bin/env python3
"""Show mileage and speed records from enviro-gps-speed (Redis + JSON)."""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

_LIB = Path("/usr/local/lib/automotive_gps")
if _LIB.is_dir():
    sys.path.insert(0, str(_LIB))
else:
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from mileage import DEFAULT_STATE_PATH, MileageStore, load_snapshot  # noqa: E402
from records import DEFAULT_STATE_PATH as RECORDS_PATH  # noqa: E402
from records import RECORD_KINDS, RECORD_LABELS, PersonalRecordsStore  # noqa: E402
from records import load_snapshot as load_records  # noqa: E402


def fmt_sec(value: float | None) -> str:
    if value is None:
        return "--"
    return f"{value:.2f}s"


def require_service_stopped(parser: argparse.ArgumentParser, what: str) -> None:
    try:
        running = subprocess.run(
            ["systemctl", "is-active", "--quiet", "enviro-gps-speed"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).returncode == 0
    except FileNotFoundError:
        running = False
    if running:
        parser.error(f"Stop enviro-gps-speed before resetting {what}, then restart it afterwards.")


def main() -> None:
    parser = argparse.ArgumentParser(description="Automotive GPS mileage & records")
    parser.add_argument(
        "--state-file",
        type=Path,
        default=DEFAULT_STATE_PATH,
        help="Mileage JSON path",
    )
    parser.add_argument(
        "--records-file",
        type=Path,
        default=RECORDS_PATH,
        help="Speed records JSON path",
    )
    parser.add_argument(
        "--export",
        action="store_true",
        help="Print mileage and records JSON (for upload)",
    )
    parser.add_argument(
        "--reset-trip",
        action="store_true",
        help="Zero trip_miles (odometer unchanged)",
    )
    parser.add_argument(
        "--reset-records",
        action="store_true",
        help="Clear today's and best-ever speed records",
    )
    args = parser.parse_args()

    if args.reset_trip:
        if args.state_file == DEFAULT_STATE_PATH:
            require_service_stopped(parser, "the trip")
        store = MileageStore(state_path=args.state_file)
        store.reset_trip()
        print("Trip miles reset.")
        return

    if args.reset_records:
        if args.records_file == RECORDS_PATH:
            require_service_stopped(parser, "records")
        PersonalRecordsStore(state_path=args.records_file).reset()
        print("Speed records reset.")
        return

    mileage = load_snapshot(state_path=args.state_file)
    records = load_records(state_path=args.records_file)

    if args.export:
        print(json.dumps({"mileage": mileage, "records": records}, indent=2))
        return

    print(f"Device:    {mileage['device_id']}")
    print(f"Odometer:  {mileage['odometer_miles']:.2f} mi")
    print(f"Trip:      {mileage['trip_miles']:.2f} mi")
    print(f"Today:     {records['today_date'] or '--'}")
    for kind in RECORD_KINDS:
        print(f"  {RECORD_LABELS[kind] + ':':<8}{fmt_sec(records[f'today_{kind}_sec'])}")
    print("Best ever:")
    for kind in RECORD_KINDS:
        print(f"  {RECORD_LABELS[kind] + ':':<8}{fmt_sec(records[f'best_{kind}_sec'])}")
    print(f"Updated:   {mileage['updated_at']}")
    print(f"State:     {args.state_file}, {args.records_file}")


if __name__ == "__main__":
    main()
