[Unit]
Description=Enviro LCD GPS speed
# Start as soon as storage + SPI are up (do not wait for WiFi / multi-user stack)
After=local-fs.target
After=systemd-udev-settle.service
Before=network-pre.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=-/etc/default/enviro-gps-speed
Type=simple
ExecStart=/usr/local/bin/enviro-gps-speed
Restart=always
RestartSec=5
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
